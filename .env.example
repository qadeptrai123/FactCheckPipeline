OPENROUTER_API_KEY=

# Controls how far the app runs for phase testing.
# Allowed values: refined, retrieval, judge
PIPELINE_MAX_PHASE=judge

REFINE_OPENROUTER_MODEL=google/gemini-2.5-flash
REFINE_FALLBACK_MODELS=qwen/qwen3-vl-8b-instruct,google/gemma-3-4b-it
REFINE_TEMPERATURE=0.1
REFINE_MAX_TOKENS=2200

SEMANTIC_MODEL=bkai-foundation-models/vietnamese-bi-encoder
SEMANTIC_THRESHOLD=85
SEMANTIC_BREAKPOINT_TYPE=percentile
SEMANTIC_SAMPLE=
SEMANTIC_CORPUS_PATH=D:/RAG-DB/FinalDataset/final_corpus.csv
SEMANTIC_OUTPUT=D:/RAG-DB/chunking_scripts/chunks_semantic.csv

FIXED_SIZE_CHUNK_SIZE=256
FIXED_SIZE_OVERLAP=40
FIXED_SIZE_ENCODING=cl100k_base
FIXED_SIZE_SAMPLE=
FIXED_SIZE_CORPUS_PATH=D:/RAG-DB/FinalDataset/final_corpus.csv
FIXED_SIZE_OUTPUT=D:/RAG-DB/chunking_scripts/chunks_fixed_size.csv
